# Caddy gets and renews the HTTPS certificate on its own.
# Set DOMAIN in .env to your real domain (its DNS must already point at this server).
# With DOMAIN=localhost you get a local certificate, handy for trying the stack out.
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Recordings for transcription are small; nothing legitimate is bigger than this.
	request_body {
		max_size 3MB
	}

	reverse_proxy app:8000 {
		health_uri /healthz
		health_interval 15s
	}
}
