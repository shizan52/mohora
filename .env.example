# Copy to .env (python run.py setup does this for you)
APP_NAME=Mohora
BASE_URL=http://127.0.0.1:8000
SECRET_KEY=change-me

# Google sign-in: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BASE_URL>/auth/callback
# Leave empty in development to get a local email-only sign-in instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that can open /admin
ADMIN_EMAILS=

# Telegram alerts: create a bot with @BotFather, then run `python run.py tg-test`
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

DB_PATH=data/app.db
TZ=Asia/Dhaka
PORT=8000
WORKERS=2
