# Copy to .env (python run.py setup does this for you). Lines starting with # are ignored.
# Comments go on their own line: anything after the = is the value.

# ------------------------------------------------------------------ the site
APP_NAME=Mohora
# The public address, no trailing slash. https:// switches on secure cookies.
BASE_URL=http://127.0.0.1:8000
# Signs sessions. Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The site refuses to start on an https address while this is still the example value.
SECRET_KEY=change-me
# Docker only: the domain Caddy gets a certificate for. Its DNS must point at this server.
DOMAIN=localhost

# ------------------------------------------------------------------ sign-in
# https://console.cloud.google.com/apis/credentials  ->  OAuth client ID, type "Web application".
# Authorized redirect URI: <BASE_URL>/auth/callback
# Leave empty while developing on localhost to get an email-only sign-in instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that can open /admin
ADMIN_EMAILS=

# ------------------------------------------------------------------ Telegram alerts for the owner
# Create a bot with @BotFather, message it once, then run: python run.py tg-test
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------------ storage and processes
# Without Docker the database is data/app.db inside the project. Docker keeps it in a volume.
# DB_PATH=data/app.db
# BACKUP_DIR=backups
TZ=Asia/Dhaka
PORT=8000
WORKERS=2

# ------------------------------------------------------------------ the built-in AI (optional, needs a GPU)
# With these set, visitors can practise with no API key at all. Everything is optional;
# without them people connect their own AI, which costs the site nothing.
# Any OpenAI-compatible server works. Full guide: docs/gpu.md
#
# With the Docker "gpu" profile (service names from docker-compose.yml):
# HOUSE_AI_URL=http://llm:11434/v1
# HOUSE_AI_MODEL=qwen2.5:14b
# HOUSE_COACH_MODEL=qwen2.5:14b
# HOUSE_TTS_URL=http://voice:8880/v1
# HOUSE_STT_URL=http://ears:8000/v1
#
# Without Docker, with Ollama on the same machine:
# HOUSE_AI_URL=http://127.0.0.1:11434/v1
# HOUSE_AI_MODEL=qwen2.5:14b
#
# Optional extras
# HOUSE_AI_KEY=
# Chat requests each person can make per day. Pro members get ten times as many.
# HOUSE_DAILY_LIMIT=150
# HOUSE_TTS_MODEL=kokoro
# HOUSE_TTS_VOICE_FEMALE=af_heart
# HOUSE_TTS_VOICE_MALE=am_michael
# Languages the voice server can speak (Kokoro: English only).
# HOUSE_TTS_LANGS=en
# HOUSE_STT_MODEL=Systran/faster-whisper-large-v3
